# انسخ هذا الملف باسم .env.local إذا بتشغل الموقع على كمبيوترك
# (على Netlify تنحط في: Project configuration > Environment variables)
# لا ترفع .env.local على GitHub أبداً

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > Publishable key (المفتاح العام فقط)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# رقم الواتس بصيغة دولية بدون + (مثال: 9665XXXXXXXX)
WHATSAPP_NUMBER=
